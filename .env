# ===================================
# MORDEKILLER BOT CONFIGURATION
# ===================================

# Bot Information
BOT_NAME=MordeKiller
OWNER_NAME=Morde
OWNER_NUMBER=254700000000
PREFIX=.

# Session
SESSION_PATH=./session

# Timezone
