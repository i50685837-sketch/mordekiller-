YOUTUBE_API_KEY=

# Database (optional)
MONGO_URI=

# Bot Settings
AUTO_READ=true
AUTO_TYPING=false
AUTO_RECORDING=false
WELCOME=true
GOODBYE=true
ANTI_LINK=true
ANTI_SPAM=true
ANTI_DELETE=true

# Logging
LOG_LEVEL=info
